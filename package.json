{
  "name": "azurescraper",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted modular scraper with a web UI (Docker / Unraid)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
